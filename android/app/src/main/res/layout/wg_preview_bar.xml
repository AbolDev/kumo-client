<?xml version="1.0" encoding="utf-8"?>
<!-- What the list of widgets shows for the quick bar before Android 15 (there the app draws the real widget): the connected look at two cells wide, with example numbers. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/wg_r20"
        android:tint="#FFFFFFFF" />

    <ImageView
        android:id="@+id/widget_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/wg_bd_20_1"
        android:tint="#FFFFFFFF"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="start|center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="12dp">

        <FrameLayout
            android:id="@+id/wg_button"
            android:layout_width="40dp"
            android:layout_height="40dp">

            <ImageView
                android:id="@+id/wg_btn_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/wg_circle"
                android:tint="#FF1E9E52" />

            <ImageView
                android:id="@+id/wg_ring"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/wg_ring"
                android:tint="#FF1D9E75" />

            <ImageView
                android:id="@+id/wg_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@string/widget_toggle"
                android:src="@drawable/ic_power"
                android:tint="#FFFFFFFF" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:textDirection="ltr"
                android:id="@+id/wg_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Kumo"
                android:textColor="#FF2C2C2A"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:textDirection="ltr"
                android:id="@+id/wg_sub"
                android:text="↓ 1.2 MB/s"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FF5F5E5A"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
