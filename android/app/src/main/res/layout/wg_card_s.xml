<?xml version="1.0" encoding="utf-8"?>
<!-- The status card in one row and about two cells wide: the power button at the start, then the name, the
     download speed and the data used. Always drawn left to right, whatever the language of the phone. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/wg_r20"
        android:tint="#FFFFFFFF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="start|center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="10dp">

        <FrameLayout
            android:id="@+id/wg_button"
            android:layout_width="38dp"
            android:layout_height="38dp">

            <ImageView
                android:id="@+id/wg_btn_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/wg_circle"
                android:tint="#FFE1F5EE" />

            <ImageView
                android:id="@+id/wg_ring"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/wg_ring"
                android:tint="#FF1D9E75" />

            <ImageView
                android:id="@+id/wg_icon"
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:layout_gravity="center"
                android:contentDescription="@string/widget_toggle"
                android:src="@drawable/ic_power"
                android:tint="#FF0F6E56" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/wg_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Kumo"
                android:textColor="#FF2C2C2A"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/wg_down"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FF2C2C2A"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/wg_total"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FF5F5E5A"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
