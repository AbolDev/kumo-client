# Maintainer: AbolDev <abolfazlbaghery07@gmail.com>
pkgname=kumo-bin
pkgver=1.13.0
pkgrel=1
pkgdesc="Free VPN client powered by sing-box and Xray"
arch=('x86_64' 'aarch64')
url="https://github.com/AbolDev/kumo-client"
license=('GPL-3.0-only')
depends=('gtk3' 'libayatana-appindicator' 'polkit')
provides=('kumo')
conflicts=('kumo')
options=('!strip' '!debug')
install=kumo.install
source_x86_64=("kumo-$pkgver-x86_64.tar.gz::$url/releases/download/v$pkgver/kumo-linux-x64-portable.tar.gz")
source_aarch64=("kumo-$pkgver-aarch64.tar.gz::$url/releases/download/v$pkgver/kumo-linux-arm64-portable.tar.gz")
sha256sums_x86_64=('1d83c2791ff676b5f8dbdcc95f98d7e8c77a72ea5c460ebd9af077edabb5e182')
sha256sums_aarch64=('e9436b8176dd222361ce226fad1af297870780ff045c1f7430a4d95ce1cc1e72')

package() {
  install -d "$pkgdir/opt/kumo"
  cp -a "$srcdir/kumo/." "$pkgdir/opt/kumo/"
  # the "portable" marker would keep the data next to the program
  rm -f "$pkgdir/opt/kumo/portable" "$pkgdir/opt/kumo/.gitignore"

  install -d "$pkgdir/usr/bin"
  ln -s /opt/kumo/kumo "$pkgdir/usr/bin/kumo"
  install -Dm644 "$pkgdir/opt/kumo/data/kumo.png" "$pkgdir/usr/share/pixmaps/kumo.png"

  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/kumo.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Kumo
Comment=Free VPN client powered by sing-box and Xray
Exec=/opt/kumo/kumo %U
Icon=kumo
Terminal=false
Categories=Network;
MimeType=x-scheme-handler/vless;x-scheme-handler/vmess;x-scheme-handler/trojan;x-scheme-handler/ss;x-scheme-handler/hysteria;x-scheme-handler/hysteria2;x-scheme-handler/hy2;x-scheme-handler/tuic;x-scheme-handler/anytls;x-scheme-handler/wireguard;x-scheme-handler/clash;x-scheme-handler/sing-box;x-scheme-handler/hiddify;
EOF
}